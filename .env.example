OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
OSS_ARN=

# Optional: Tencent Cloud COS integration tests. When these are empty the
# COS integration suite (test/cos-integration.spec.ts) is skipped.
# COS bucket names must include the APPID suffix, e.g. examplebucket-1250000000.
COS_ACCESS_KEY_ID=
COS_ACCESS_KEY_SECRET=
COS_BUCKET=
COS_REGION=
COS_STS_ROLE_ARN=

# Optional: Huawei Cloud OBS integration tests. When these are empty the
# OBS integration suite (test/obs-integration.spec.ts) is skipped.
OBS_ACCESS_KEY_ID=
OBS_ACCESS_KEY_SECRET=
OBS_BUCKET=
OBS_REGION=

# Optional: AWS S3 integration tests. When these are empty the
# AWS integration suite (test/aws-integration.spec.ts) is skipped.
AWS_ACCESS_KEY_ID=
AWS_ACCESS_KEY_SECRET=
AWS_BUCKET=
AWS_REGION=
