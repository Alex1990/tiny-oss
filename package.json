{
  "name": "tiny-oss",
  "version": "1.0.2",
  "description": "A tiny object storage sdk for browsers, Node.js and mini programs, focused on uploading",
  "type": "module",
  "main": "dist/tiny-oss.es.js",
  "types": "dist/tiny-oss.es.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tiny-oss.es.d.ts",
      "import": "./dist/tiny-oss.es.js"
    },
    "./cos": {
      "types": "./dist/tiny-oss.cos.es.d.ts",
      "import": "./dist/tiny-oss.cos.es.js"
    },
    "./obs": {
      "types": "./dist/tiny-oss.obs.es.d.ts",
      "import": "./dist/tiny-oss.obs.es.js"
    },
    "./aws": {
      "types": "./dist/tiny-oss.aws.es.d.ts",
      "import": "./dist/tiny-oss.aws.es.js"
    },
    "./azure": {
      "types": "./dist/tiny-oss.azure.es.d.ts",
      "import": "./dist/tiny-oss.azure.es.js"
    },
    "./protocol": {
      "types": "./dist/tiny-oss.protocol.es.d.ts",
      "import": "./dist/tiny-oss.protocol.es.js"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "dist",
    "UPGRADING.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "lint": "oxlint src test",
    "fmt": "oxfmt src test",
    "fmt:check": "oxfmt --check src test",
    "build": "tsup && npm run build:types:default && npm run build:types:cos && npm run build:types:obs && npm run build:types:aws && npm run build:types:azure && npm run build:types:protocol",
    "build:types:default": "dts-bundle-generator src/index.ts -o dist/tiny-oss.es.d.ts --project tsconfig.json --sort",
    "build:types:cos": "dts-bundle-generator src/cos/index.ts -o dist/tiny-oss.cos.es.d.ts --project tsconfig.json --sort",
    "build:types:obs": "dts-bundle-generator src/obs/index.ts -o dist/tiny-oss.obs.es.d.ts --project tsconfig.json --sort",
    "build:types:aws": "dts-bundle-generator src/aws/index.ts -o dist/tiny-oss.aws.es.d.ts --project tsconfig.json --sort",
    "build:types:azure": "dts-bundle-generator src/azure/index.ts -o dist/tiny-oss.azure.es.d.ts --project tsconfig.json --sort",
    "build:types:protocol": "dts-bundle-generator src/provider.ts -o dist/tiny-oss.protocol.es.d.ts --project tsconfig.json --sort",
    "check:types": "tsc --noEmit --skipLibCheck test/test-types.ts && tsc --noEmit --skipLibCheck test/test-types-cos.ts && tsc --noEmit --skipLibCheck test/test-types-obs.ts && tsc --noEmit --skipLibCheck test/test-types-aws.ts && tsc --noEmit --skipLibCheck test/test-types-azure.ts && tsc --noEmit --skipLibCheck test/test-types-protocol.ts",
    "changelog": "changelogen",
    "release": "bumpp",
    "dev": "vite",
    "serve": "tsx test/server.ts",
    "test": "vitest",
    "test:azure-oracle": "tsx test/azure-oracle.node.ts",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest run --browser.headless",
    "test:ci:coverage": "vitest run  --browser.headless --coverage",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alex1990/tiny-oss.git"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "keywords": [
    "aliyun",
    "oss",
    "cos",
    "obs",
    "s3",
    "aws",
    "azure",
    "object-storage",
    "cloud-storage",
    "upload",
    "sdk"
  ],
  "author": "Alex Chao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Alex1990/tiny-oss/issues"
  },
  "homepage": "https://github.com/Alex1990/tiny-oss#readme",
  "devDependencies": {
    "@azure/storage-blob": "12.30.0",
    "@hono/node-server": "^1.19.15",
    "@types/ali-oss": "^6.23.3",
    "@types/node": "^25.0.9",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "ali-oss": "^6.23.0",
    "aws-sdk": "2.1693.0",
    "bumpp": "^12.2.2",
    "changelogen": "^0.6.2",
    "cos-js-sdk-v5": "^1.10.1",
    "dotenv": "^17.2.3",
    "dts-bundle-generator": "^9.5.1",
    "esdk-obs-browserjs": "3.25.51",
    "hono": "^4.12.34",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.41.0",
    "playwright": "^1.57.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "js-base64": "^3.9.3"
  }
}
